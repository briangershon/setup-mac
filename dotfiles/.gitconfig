[user]
  name = Brian Gershon
  email = briangershon@users.noreply.github.com
  signingkey = C04296150767D5F0

[commit]
  gpgsign = true

# [url "git@github.com:"]
#   insteadOf = https://github.com/

[pull]
  ff = only
  rebase = true

[push]
  default = simple

[fetch]
  prune = true

[merge]
  ff = false

[grep]
  lineNumber = true

[filter "lfs"]
  clean = git-lfs clean -- %f
  smudge = git-lfs smudge -- %f
  process = git-lfs filter-process
  required = true

[alias]
  st = status
  ci = commit
  br = branch
  co = checkout
  df = difftool --tool meld --dir-diff
  lp = log -p
  me = config user.name
  bn = !git for-each-ref --sort=-committerdate refs/heads/ --format='%(committerdate:short) %(authorname) %(refname:short)' | sed 8q
  bn-all = !git for-each-ref --sort=-committerdate refs/heads/ --format='%(committerdate:short) %(authorname) %(refname:short)'
  lg = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr)%Creset' --abbrev-commit --date=relative
  all = !git log --all
  today = !git all --since='12am' --committer=\"`git me`\"
  today-all = !git all --since='12am'
  lol = log --graph --decorate --pretty=oneline --abbrev-commit
  lola = log --graph --decorate --pretty=oneline --abbrev-commit --all
  remove-merged = !git branch --merged | grep -v \"\\* master\" | xargs -n 1 git branch -d
  prune-stale = remote prune origin

[init]
  defaultBranch = main

# this tells git to only check file size and mode (not mtime/inode), which is stable across the Docker bind mount boundary
[core]
	checkStat = minimal
[gpg]
	program = /opt/homebrew/bin/gpg
